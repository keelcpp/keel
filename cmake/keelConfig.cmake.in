@PACKAGE_INIT@

if(NOT WIN32 AND NOT EMSCRIPTEN)
    include(CMakeFindDependencyMacro)
    set(THREADS_PREFER_PTHREAD_FLAG ON)
    find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/keelTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/KeelGuidelines.cmake")
check_required_components(keel)
